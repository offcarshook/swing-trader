# Copy to .env (git-ignored). Nothing here enables live trading -- that is impossible by design.

# --- TradingAgents research (optional; agents.mode defaults to "advisory") ---
# One provider key is enough; defaults: anthropic -> claude-opus-5-5 / claude-sonnet-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# TRADINGAGENTS_LLM_PROVIDER=anthropic
# TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-5-5
# TRADINGAGENTS_QUICK_THINK_LLM=claude-sonnet-5

# --- LumiBot paper trading (paper/demo accounts only) ---
# TRADOVATE_USERNAME=
# TRADOVATE_DEDICATED_PASSWORD=
# TRADOVATE_CID=
# TRADOVATE_SECRET=
# TRADOVATE_IS_PAPER=true
# or Interactive Brokers paper gateway:
# INTERACTIVE_BROKERS_PORT=7497
# INTERACTIVE_BROKERS_CLIENT_ID=17
